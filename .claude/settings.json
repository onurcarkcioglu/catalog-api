{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.config/securestream/**)",
      "Read(~/.ssh/**)",
      "Read(~/.kube/**)",
      "Read(*.env)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(vault kv get *)",
      "Bash(kubectl get secret*)",
      "Bash(kubectl get secrets*)",
      "Bash(kubectl describe secret*)",
      "Bash(kubectl * -o yaml*)",
      "Bash(kubectl * -o json*)",
      "Bash(git push * --delete*)",
      "Bash(git push --delete*)",
      "Bash(git push * -d *)",
      "Bash(git push -d *)",
      "Bash(git push * :**)",
      "Bash(git branch -D *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(helm upgrade *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(ssh *)",
      "Bash(sudo *)"
    ]
  }
}
