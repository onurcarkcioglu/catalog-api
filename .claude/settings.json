{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.config/securestream/**)",
      "Read(~/.ssh/**)",
      "Read(~/.kube/**)",
      "Read(*.env)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(vault kv get *)",
      "Bash(kubectl get secret*)",
      "Bash(kubectl get secrets*)",
      "Bash(kubectl describe secret*)",
      "Bash(git push * --delete*)",
      "Bash(git push --delete*)",
      "Bash(git push * -d *)",
      "Bash(git push -d *)",
      "Bash(git push * :**)",
      "Bash(git branch -D *)",
      "Read(/etc/securestream/**)",
      "Bash(*admin.kubeconfig*)",
      "Bash(*--kubeconfig*)",
      "Bash(*KUBECONFIG=*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(helm upgrade *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl delete *)",
      "Bash(ssh *)",
      "Bash(sudo *)",
      "Bash(*claude-kubeconfig.sh*)",
      "Bash(*kubeconfig-lockdown.sh*)"
    ]
  },
  "env": {
    "KUBECONFIG": "/home/ubuntu/.kube/claude-readonly.yaml"
  }
}
